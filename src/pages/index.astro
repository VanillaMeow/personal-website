---
import { Image } from 'astro:assets';

import bgImage from '../assets/bg.png';
import Card from '../components/MainCard.svelte';
import Rain from '../components/rain/Rain.svelte';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <!-- Background image -->
    <Image
        src={bgImage}
        alt='Background image'
        class='fixed inset-0 -z-20 w-full h-full object-cover object-center scale-110 blur-12px brightness-40'
        width='1920'
        height='1080'
        loading='lazy'
        decoding='async'
        fetchpriority='high'
        aria-hidden='true'
    />

    <!-- Rain animation -->
    <Rain client:load client:only='svelte' />

    <!-- Main content -->
    <main class='relative z-10 flex items-center justify-center min-h-dvh p-2 sm:p-4'>
        <Card client:load />
    </main>
</Layout>
